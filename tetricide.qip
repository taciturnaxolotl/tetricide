set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "src/game_logic.vhd"]
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "src/renderer.vhd"]
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "src/tetris_core.vhd"]
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "src/vga_timing.vhd"]
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "src/clk_div2.vhd"]
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "src/vga_out.vhd"]
