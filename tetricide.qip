# Add this one file to the Quartus project (Project > Add/Remove Files)
# and every VHDL file below comes with it.
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "src/pieces.vhd"]
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "src/art.vhd"]
